# ═══ Firebase Web App конфиг ═══
# Получить в Firebase Console → Project Settings → Your apps → SDK setup and configuration
#
# ВАЖНО: эти значения встраиваются в клиентский бандл при сборке и видны публично.
# Это не секрет, но и не кладём в git, чтобы можно было держать dev/prod в разных проектах.
# Настоящая защита — Firestore Security Rules + ограничение API-ключа по HTTP referrer в GCP Console.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
