rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRoomPlayer(roomId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    function isRoomHost(roomId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)).data.isHost == true;
    }

    // ═══ Профили пользователей ═══
    // Читать профили может любой залогиненный — нужно для страницы профиля и списка друзей.
    // Писать — только владелец.
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      // Подколлекция друзей.
      // Каждый документ — связь текущего юзера с другим, id документа = peerUid.
      match /friends/{peerUid} {
        // Читать — только владелец списка
        allow read: if isSignedIn() && request.auth.uid == userId;

        // Писать в свой список — свободно (принять/отклонить/удалить/отправить)
        allow write: if isSignedIn() && request.auth.uid == userId;

        // Другой юзер может создать/обновить документ в МОЁМ списке друзей,
        // но только если docId == его uid (т.е. он добавляет себя как заявителя),
        // и только для полей заявки (status = pending|accepted).
        allow create: if isSignedIn()
                      && request.auth.uid == peerUid
                      && request.resource.data.status in ['pending'];
        allow update: if isSignedIn()
                      && request.auth.uid == peerUid
                      && request.resource.data.status in ['accepted'];
        // Удалять документ в чужом списке нельзя
      }

      // Подколлекция истории игр — пишет сам пользователь
      match /gameHistory/{gameId} {
        allow read:  if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ═══ Паки карт ═══
    match /packs/{packId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ═══ Комнаты ═══
    match /rooms/{roomId} {
      // Любой залогиненный может читать/листать (нужно для списка публичных лобби и для входа по коду)
      allow read, list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid;

      allow update: if isRoomHost(roomId) || isRoomPlayer(roomId);

      allow delete: if isRoomHost(roomId);

      match /players/{playerId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.auth.uid == playerId
          && request.resource.data.uid == request.auth.uid;

        allow update: if isRoomPlayer(roomId);

        allow delete: if isRoomHost(roomId) || request.auth.uid == playerId;
      }
    }
  }
}
